# ── Base de datos (Postgres en la UE: Neon/Supabase región Frankfurt) ──
DATABASE_URL=postgres://noor:noor@localhost:5432/noor_hub

# ── App ──
APP_URL=http://localhost:3000
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Clave para cifrar tokens de Google/banco: openssl rand -base64 32
ENCRYPTION_KEY=
# Emails que pueden entrar (separados por coma). El resto, por invitación.
ALLOWED_EMAILS=acostamedicalconsulting@gmail.com

# ── Google Cloud (OAuth: login + Gmail + Drive) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Claude API (lectura de facturas) ──
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# ── Banco vía PSD2 (Enable Banking). Opcional: sin esto, importa Norma 43 ──
ENABLEBANKING_APP_ID=
# PEM en una sola línea con \n
ENABLEBANKING_PRIVATE_KEY=

# ── Automatización ──
# openssl rand -hex 24  (Vercel Cron lo envía como Bearer)
CRON_SECRET=
# Fase 2: envío trimestral a la gestoría
FEATURE_GESTORIA_EMAIL=false
