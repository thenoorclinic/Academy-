{
  "name": "noor-hub",
  "version": "0.1.0",
  "private": true,
  "description": "The NOOR Clinic — gestión de facturas de compra, conciliación bancaria y envío a gestoría",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "sync": "tsx scripts/sync.ts",
    "vercel-build": "if [ -n \"$DATABASE_URL\" ]; then drizzle-kit migrate; fi && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "googleapis": "^183.0.0",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
